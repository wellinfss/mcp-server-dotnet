{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MCPServer": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=mcpserver;Username=mcpuser;Password=mcppass"
  },
  "Mcp": {
    "Port": 7001,
    "Host": "0.0.0.0",
    "BasePath": "/mcp",
    "Cors": {
      "AllowedOrigins": "*",
      "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "AllowedHeaders": ["*"]
    }
  },
  "Jwt": {
    "Key": "your-super-secret-key-with-at-least-32-characters",
    "Issuer": "MCPServer",
    "Audience": "MCPClient",
    "ExpiryInMinutes": 60
  }
} 